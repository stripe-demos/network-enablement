{
  "redirects": [
    { "source": "/", "has": [{ "type": "query", "key": "new" }], "destination": "/console/", "permanent": false },
    { "source": "/", "destination": "/dashboard/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/dashboard/(.*)", "destination": "/dashboard/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
